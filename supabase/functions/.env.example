DHL_API_KEY=
# La API oficial de DHL usa la misma URL para sandbox y producción.
# No uses `demo-key` para operación real: solo devuelve respuestas simuladas.
DHL_TRACKING_API_URL=https://api-eu.dhl.com/track/shipments

# Shipment Tracking Unified Push. Mantener todos estos valores solo en secretos de Supabase.
DHL_PUSH_API_KEY=
DHL_PUSH_API_SECRET=
DHL_PUSH_ACCOUNT_ID=BIOSIMEX
DHL_PUSH_API_BASE=https://api-eu.dhl.com/tracking/push/v1
DHL_PUSH_WEBHOOK_TOKEN=

# MyDHL Express REST: credenciales de produccion, independientes de Unified Push.
DHL_MYDHL_USERNAME=
DHL_MYDHL_PASSWORD=
# Set to push to serve saved Unified Push notifications instead of MyDHL polling.
DHL_LOOKUP_PROVIDER=
