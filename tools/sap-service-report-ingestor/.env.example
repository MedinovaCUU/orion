# Buzon dedicado que recibe los reenvios de SAP FSM.
IMAP_HOST=imap.example.com
IMAP_PORT=993
IMAP_USERNAME=mantenimientos@example.com
IMAP_PASSWORD=use-un-secreto-o-password-de-aplicacion
IMAP_MAILBOX=INBOX
SAP_ALLOWED_SENDER=noreply@eu.fsm.cloud.sap
# Opcional: remitentes internos autorizados para reenviar manualmente. Separar con comas.
SAP_ALLOWED_FORWARDERS=

# Proyecto Supabase. Esta llave solo debe vivir en el servidor del worker.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_STORAGE_BUCKET=sap-service-reports

# El OCR solo se usa cuando el PDF no contiene suficiente texto digital.
OCR_LANGUAGE=spa+eng

# En macOS los secretos pueden guardarse en Llavero en vez de escribirlos aqui.
KEYCHAIN_IMAP_SERVICE=orion-sap-imap
KEYCHAIN_SUPABASE_SERVICE=orion-sap-supabase-service-role
